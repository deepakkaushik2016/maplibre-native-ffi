+namespace {
+
+// Renders a still image, answering each request of `kind` once, as a file
+// source that doesn't retry does.
+std::exception_ptr renderStill(MapTest<FakeFileSource>& test, Resource::Kind kind, const Response& response) {
+    std::optional<std::exception_ptr> result;
+    test.map.renderStill([&](const std::exception_ptr& error) { result = error; });
+    while (!result) {
+        auto& requests = test.fileSource->requests;
+        auto it = std::ranges::find_if(
+            requests, [&](const auto* request) { return request->resource.kind == kind && request->callback; });
+        if (it == requests.end()) {
+            util::RunLoop::Get()->runOnce();
+        } else {
+            // Calling the callback may deallocate the request.
+            std::exchange((*it)->callback, nullptr)(response);
+        }
+    }
+    return *result;
+}
+
+Response failedResponse() {
+    Response response;
+    response.error = std::make_unique<Response::Error>(Response::Error::Reason::Server, "failed");
+    return response;
+}
+
+Response emptyResponse() {
+    Response response;
+    response.noContent = true;
+    return response;
+}
+
+} // namespace
