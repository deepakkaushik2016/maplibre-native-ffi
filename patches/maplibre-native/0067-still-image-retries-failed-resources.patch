+TEST(Map, StillImageRetriesFailedTile) {
+    MapTest<FakeFileSource> test;
+    test.map.getStyle().loadJSON(R"({
+        "version": 8,
+        "sources": {"tiles": {"type": "vector", "tiles": ["http://example.com/{z}/{x}/{y}.pbf"], "maxzoom": 0}},
+        "layers": [{"id": "fill", "type": "fill", "source": "tiles", "source-layer": "any"}]
+    })");
+    EXPECT_NE(nullptr, renderStill(test, Resource::Kind::Tile, failedResponse()));
+    EXPECT_EQ(nullptr, renderStill(test, Resource::Kind::Tile, emptyResponse()));
+}
