+
+// An animation that leaves the center where it is, such as a rotation, eases the center's height
+// to the ground under it too. Here the center has just jumped from the 6,000 m plateau to the flat
+// ground north of the ridge, keeping the plateau's height, and a rotation starts before the
+// renderer reports the ground there. Once it does, the rotation carries the center down to that
+// ground instead of holding it 6,000 m up until the rotation ends.
+TEST(TerrainCamera, ARotationEasesTheCenterHeightToTheGroundUnderIt) {
+    util::RunLoop loop;
+    auto fileSource = std::make_shared<StubFileSource>(ResourceOptions::Default(), ClientOptions());
+    fileSource->tileResponse = [](const Resource& resource) {
+        Response res;
+        res.data = std::make_shared<std::string>(makeRampDEMTile(resource.url));
+        return res;
+    };
+    HeadlessFrontend frontend{{390, 844}, 1};
+    MapAdapter map(frontend,
+                   MapObserver::nullObserver(),
+                   fileSource,
+                   MapOptions().withMapMode(MapMode::Continuous).withSize(frontend.getSize()));
+    map.setCenterClampedToGround(true);
+    map.setBounds(BoundOptions().withMaxPitch(85.0));
+    map.getStyle().loadJSON(rampStyle);
+    const auto pump = [&](std::chrono::milliseconds duration, const std::function<bool()>& done = nullptr) {
+        const auto end = std::chrono::steady_clock::now() + duration;
+        while (std::chrono::steady_clock::now() < end && !(done && done())) {
+            loop.runOnce();
+            std::this_thread::sleep_for(std::chrono::milliseconds(8));
+        }
+    };
+    map.jumpTo(CameraOptions().withCenter(LatLng{47.20, 11.4041}).withZoom(10.0).withPitch(0.0).withBearing(0.0));
+    pump(std::chrono::milliseconds(2000));
+    map.jumpTo(CameraOptions().withZoom(14.0).withPitch(60.0));
+    pump(std::chrono::milliseconds(2000));
+    ASSERT_NEAR(*map.getCameraOptions().centerAltitude, 6000.0, 30.0) << "the center starts on the plateau";
+
+    bool finished = false;
+    double altitudeAtTheEnd = std::numeric_limits<double>::quiet_NaN();
+    AnimationOptions animation(Milliseconds(3000));
+    animation.transitionFinishFn = [&] {
+        finished = true;
+        altitudeAtTheEnd = map.getCameraOptions().centerAltitude.value_or(0.0);
+    };
+    map.jumpTo(CameraOptions().withCenter(LatLng{47.40, 11.4041}));
+    map.easeTo(CameraOptions().withBearing(90.0), animation);
+    pump(std::chrono::milliseconds(15000), [&] { return finished; });
+    ASSERT_TRUE(finished);
+    EXPECT_NEAR(altitudeAtTheEnd, 0.0, 30.0) << "the center's height reached the ground under it";
+    EXPECT_NEAR(*map.getCameraOptions().bearing, 90.0, 1e-6) << "the rotation ran to its end";
+}
