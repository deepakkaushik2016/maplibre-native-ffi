+
+TEST(Transform, CancelTransitionsByIdLeavesOthersRunning) {
+    struct Observer : TransformObserver {
+        unsigned changes = 0;
+        void onCameraDidChange(MapObserver::CameraChangeMode) override { ++changes; }
+    } observer;
+    Transform transform(observer);
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withZoom(8));
+    unsigned zoomFinished = 0;
+    unsigned bearingFinished = 0;
+    AnimationOptions zoom(Seconds(4));
+    zoom.transitionId = 1;
+    zoom.transitionFinishFn = [&] {
+        ++zoomFinished;
+    };
+    AnimationOptions bearing(Seconds(4));
+    bearing.transitionId = 2;
+    bearing.transitionFinishFn = [&] {
+        ++bearingFinished;
+    };
+    transform.easeTo(CameraOptions().withZoom(12), zoom);
+    transform.easeTo(CameraOptions().withBearing(80), bearing);
+    const auto start = transform.getLatestTransitionStart();
+    transform.updateTransitions(start + Seconds(1));
+    const auto zoomAtCancel = transform.getZoom();
+    observer.changes = 0;
+
+    // Only the command with the identity finishes, once, and the other keeps
+    // animating.
+    EXPECT_TRUE(transform.cancelTransitions(1));
+    EXPECT_EQ(zoomFinished, 1u);
+    EXPECT_EQ(bearingFinished, 0u);
+    EXPECT_EQ(observer.changes, 1u);
+    EXPECT_TRUE(transform.inTransition());
+    EXPECT_FALSE(transform.isScaling());
+    EXPECT_TRUE(transform.isRotating());
+
+    // An identity that no running command carries finishes nothing and
+    // reports no change.
+    EXPECT_FALSE(transform.cancelTransitions(1));
+    EXPECT_FALSE(transform.cancelTransitions(3));
+    EXPECT_EQ(zoomFinished, 1u);
+    EXPECT_EQ(observer.changes, 1u);
+    EXPECT_TRUE(transform.inTransition());
+
+    transform.updateTransitions(start + Seconds(4));
+    EXPECT_NEAR(transform.getZoom(), zoomAtCancel, 1e-5);
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 80, 1e-5);
+    EXPECT_EQ(zoomFinished, 1u);
+    EXPECT_EQ(bearingFinished, 1u);
+    EXPECT_FALSE(transform.inTransition());
+}
