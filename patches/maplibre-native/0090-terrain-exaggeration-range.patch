diff --git a/test/style/conversion/terrain.test.cpp b/test/style/conversion/terrain.test.cpp
new file mode 100644
index 0000000000..de044f46bd
--- /dev/null
+++ b/test/style/conversion/terrain.test.cpp
@@ -0,0 +1,39 @@
+#include <mln/test/util.hpp>
+
+#include <mln/style/conversion/json.hpp>
+#include <mln/style/conversion/terrain.hpp>
+#include <mln/style/conversion_impl.hpp>
+#include <mln/style/rapidjson_conversion.hpp>
+#include <mln/util/rapidjson.hpp>
+
+using namespace mln;
+using namespace mln::style;
+using namespace mln::style::conversion;
+
+TEST(StyleConversion, Terrain) {
+    Error error;
+
+    auto terrain = convertJSON<Terrain>(R"({"source":"dem"})", error);
+    ASSERT_TRUE(terrain);
+    EXPECT_EQ("dem", terrain->getSource());
+    EXPECT_EQ(1.0f, terrain->getExaggeration());
+
+    terrain = convertJSON<Terrain>(R"({"source":"dem","exaggeration":0})", error);
+    ASSERT_TRUE(terrain);
+    EXPECT_EQ(0.0f, terrain->getExaggeration());
+
+    terrain = convertJSON<Terrain>(R"({"source":"dem","exaggeration":1.5})", error);
+    ASSERT_TRUE(terrain);
+    EXPECT_EQ(1.5f, terrain->getExaggeration());
+}
+
+// The style spec's range is at least 0. A float can't hold 1e39, so it would
+// store infinity.
+TEST(StyleConversion, TerrainExaggerationOutOfRange) {
+    for (const auto* json : {R"({"source":"dem","exaggeration":-1})", R"({"source":"dem","exaggeration":1e39})"}) {
+        SCOPED_TRACE(json);
+        Error error;
+        EXPECT_FALSE(convertJSON<Terrain>(json, error));
+        EXPECT_EQ("terrain exaggeration must be a finite number of at least 0", error.message);
+    }
+}
diff --git a/test/style/style_parser.test.cpp b/test/style/style_parser.test.cpp
index a86ddac12e..268a78aa4e 100644
--- a/test/style/style_parser.test.cpp
+++ b/test/style/style_parser.test.cpp
@@ -326,3 +326,21 @@ TEST(StyleParser, NestingDepthLimit) {
     // Deep enough to overflow the stack if the parser recursed through it all.
     EXPECT_EQ(parse(1000000), "Arrays and objects nest too deeply. at offset 256");
 }
+
+// A style document's terrain goes through the same range check as one set on
+// its own: out of range, the style loads without terrain and logs why.
+TEST(StyleParser, TerrainExaggerationOutOfRange) {
+    for (const auto* exaggeration : {"-1", "1e39"}) {
+        SCOPED_TRACE(exaggeration);
+        FixtureLog log;
+        style::Parser parser;
+        ASSERT_FALSE(parser.parse(std::string(R"({"version":8,"sources":{},"layers":[],)") +
+                                  R"("terrain":{"source":"dem","exaggeration":)" + exaggeration + "}}"));
+        EXPECT_FALSE(parser.terrain);
+        EXPECT_EQ(1u,
+                  log.count({EventSeverity::Warning,
+                             Event::ParseStyle,
+                             -1,
+                             "terrain exaggeration must be a finite number of at least 0"}));
+    }
+}
