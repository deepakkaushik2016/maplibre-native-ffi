+    test.map.setCenterClampedToGround(true);
+    EXPECT_NEAR(*test.map.getCameraOptions({}).centerAltitude, plateauMeters, 5.0);
+    EXPECT_NEAR(test.renderAndGetAltitude(4), plateauMeters, 5.0);
+}
